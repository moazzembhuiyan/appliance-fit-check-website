# Base URL of your existing backend (no trailing slash). Required for real API mode.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# "true" = use the in-browser mock adapter (demo only, NOT real security). Set "false" once your API is connected.
NEXT_PUBLIC_USE_MOCK_API=true
# Public site URL used for canonical links / sitemap
NEXT_PUBLIC_SITE_URL=https://appliancefitcheck.org
# Store links
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
